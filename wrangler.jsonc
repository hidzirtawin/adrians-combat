{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adrians-combat",
  "main": "server/cloudflareWorker.mjs",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SQUAD",
        "class_name": "SquadRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SquadRoom"]
    }
  ]
}
